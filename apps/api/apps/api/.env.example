# Copia este archivo a ".env" (sin el ".example") y pon tus datos reales.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore) porque
# tiene tu contraseña real de Postgres.

# Conexión con el rol de aplicación (ticketya_app) — sujeta a RLS de
# verdad. Se usa para todo lo que pertenece a una cooperativa específica.
DATABASE_URL=postgresql://ticketya_app:cambia_esta_contrasena_app@localhost:5432/ticketya

# Conexión con el rol de plataforma (ticketya_platform_admin) — con
# BYPASSRLS, ve todas las cooperativas a la vez. Se usa solo para
# lecturas que son legítimamente cross-tenant (búsqueda de viajes para
# pasajeros, dashboard de administración de plataforma).
DATABASE_URL_PUBLICO=postgresql://ticketya_platform_admin:cambia_esta_contrasena_admin@localhost:5432/ticketya

# Clave secreta para firmar los tokens de sesión (JWT). Debe ser un texto
# largo y aleatorio, distinto en cada entorno (desarrollo/producción).
# Nunca reutilices el mismo valor de ejemplo en producción.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-solo-tuyo
